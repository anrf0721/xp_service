# Copy to .env locally; scripts/run.ps1 loads it without printing secrets.
XP_PG_HOST=192.168.100.128
XP_PG_PORT=5432
XP_PG_USER=YOUR_POSTGRES_ROLE
XP_PG_PASSWORD=YOUR_POSTGRES_PASSWORD
XP_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
XP_OWNER_SECRET=REPLACE_WITH_OWNER_SECRET
XP_AUTHORIZED_USER_SECRET=REPLACE_WITH_AUTHORIZED_USER_SECRET
XP_ADVISOR_SECRET=REPLACE_WITH_ADVISOR_SECRET
XP_BIND_HOST=127.0.0.1
XP_AI_WORKER_ENABLED=true
XP_ACCOUNT_URL=http://127.0.0.1:8003
XP_PROCEDURE_URL=http://127.0.0.1:8001
XP_AI_URL=http://127.0.0.1:8002
